[Unit]
Description=Moziketo downloader (Spotify → S3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/moz-downloader
EnvironmentFile=/opt/moz-downloader/.env
ExecStart=/opt/moz-downloader/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
