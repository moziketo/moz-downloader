MOZ_RELAY_HOST=0.0.0.0
MOZ_RELAY_PORT=8787
MOZ_RELAY_SECRET=change-me
MOZ_PUBLIC_BASE_URL=https://dl.moziketo.ir/music
MOZ_DOWNLOAD_DIR=/var/lib/moz-downloader/cache
MOZ_YTDLP=/usr/local/bin/yt-dlp

# Optional — auto-resolve Spotify metadata (Client Credentials app)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Arvan S3 — same bucket as moziketo-wave
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_BUCKET=moziketo
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_UPLOAD_ACL=public-read
S3_PRESIGN_TTL_SECONDS=3600
